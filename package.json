{
  "name": "timer-angular",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "deploy": "ng deploy --base-href=/timer-frontend-angular/",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "tauri": "tauri",
    "tauri:serve": "tauri dev",
    "tauri:bundle": "tauri build",
    "lint": "ng lint"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.10.0",
  "dependencies": {
    "@angular/common": "^22.1.1",
    "@angular/compiler": "^22.1.1",
    "@angular/core": "^22.1.1",
    "@angular/forms": "^22.1.1",
    "@angular/platform-browser": "^22.1.1",
    "@angular/router": "^22.1.1",
    "@capacitor/android": "^8.4.2",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@stomp/rx-stomp": "^2.4.0",
    "dexie": "^4.4.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.3",
    "@angular/cli": "^22.1.3",
    "@angular/compiler-cli": "^22.1.1",
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.11.2",
    "angular-cli-ghpages": "^3.0.3",
    "angular-eslint": "21.4.0",
    "esbuild-visualizer": "^0.7.0",
    "eslint": "^10.3.0",
    "jsdom": "^27.1.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "8.59.2",
    "vitest": "^4.0.8"
  }
}
